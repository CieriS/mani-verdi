{
  "ci": {
    "collect": {
      "startServerCommand": "npm run preview -- --port 4333 --ignore-lock",
      "startServerReadyPattern": "localhost:4333",
      "url": ["http://localhost:4333/", "http://localhost:4333/servizi/manutenzione-giardini/", "http://localhost:4333/privacy/"],
      "numberOfRuns": 3
    },
    "assert": {
      "assertions": {
        "categories:performance": ["warn", { "minScore": 0.9, "aggregationMethod": "median" }],
        "categories:accessibility": ["error", { "minScore": 1 }],
        "categories:seo": ["error", { "minScore": 1 }],
        "categories:best-practices": ["error", { "minScore": 1 }],
        "largest-contentful-paint": ["error", { "maxNumericValue": 3000, "aggregationMethod": "median" }],
        "cumulative-layout-shift": ["error", { "maxNumericValue": 0.02, "aggregationMethod": "median" }],
        "total-blocking-time": ["warn", { "maxNumericValue": 200, "aggregationMethod": "median" }],
        "total-byte-weight": ["error", { "maxNumericValue": 500000 }]
      }
    },
    "upload": { "target": "filesystem", "outputDir": ".lighthouseci" }
  }
}
