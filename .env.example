# URL pubblico del sito, senza slash finale (serve per canonical, sitemap e Open Graph)
SITE_URL=https://www.example.com

# Chiave Web3Forms (https://web3forms.com): gratuita, si ottiene inserendo l'email di Tommaso.
# Se resta vuota, il form ripiega su WhatsApp con messaggio precompilato.
PUBLIC_FORM_ACCESS_KEY=

# Endpoint del servizio form. Cambialo solo se usi un servizio diverso da Web3Forms.
PUBLIC_FORM_ENDPOINT=https://api.web3forms.com/submit
