---
import type { HTMLTag } from 'astro/types';

interface Props {
  as?: HTMLTag;
  /** "page" = larghezza piena del sito, "prose" = colonna di lettura */
  width?: 'page' | 'prose';
  class?: string;
}

const { as: Tag = 'div', width = 'page', class: className } = Astro.props;
---

<Tag class:list={['mx-auto w-full px-gutter', width === 'page' ? 'max-w-page' : 'max-w-prose', className]}>
  <slot />
</Tag>
