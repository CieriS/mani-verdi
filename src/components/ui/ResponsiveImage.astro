---
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';

interface Props {
  src: ImageMetadata;
  /** Testo alternativo descrittivo, in italiano */
  alt: string;
  /** Proporzioni fisse del riquadro: evitano salti di layout (CLS) */
  ratio?: '4/3' | '4/5' | '1/1' | '16/9' | '3/2';
  /** Larghezze generate per srcset */
  widths?: number[];
  /** Attributo sizes: quanto è larga l'immagine nel layout */
  sizes?: string;
  /** true solo per l'immagine principale sopra la piega (hero) */
  priority?: boolean;
  /** Classi del riquadro <picture> */
  class?: string;
  /** Nome per le View Transitions tra pagine */
  transitionName?: string;
}

const {
  src,
  alt,
  ratio = '4/3',
  widths = [400, 640, 960, 1280],
  sizes = '(min-width: 64rem) 33vw, (min-width: 40rem) 50vw, 100vw',
  priority = false,
  class: className,
  transitionName,
} = Astro.props;

const [ratioW = 4, ratioH = 3] = ratio.split('/').map(Number);
// Astro può solo rimpicciolire: non si generano varianti più larghe dell'originale.
const usableWidths = widths.filter((w) => w <= src.width);
const finalWidths = usableWidths.length > 0 ? usableWidths : [src.width];
const width = Math.max(...finalWidths);
const height = Math.round((width * ratioH) / ratioW);
---

<Picture
  src={src}
  alt={alt}
  formats={['avif', 'webp']}
  widths={finalWidths}
  sizes={sizes}
  width={width}
  height={height}
  fit="cover"
  loading={priority ? 'eager' : 'lazy'}
  decoding={priority ? 'sync' : 'async'}
  fetchpriority={priority ? 'high' : 'auto'}
  class="h-full w-full object-cover"
  pictureAttributes={{
    class: ['block overflow-hidden bg-subtle', className].filter(Boolean).join(' '),
    style: `aspect-ratio:${ratioW}/${ratioH};${transitionName ? `view-transition-name:${transitionName};` : ''}`,
  }}
/>
