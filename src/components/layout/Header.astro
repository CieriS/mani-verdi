---
import { cta, navigation, phoneUrl, site, whatsappUrl } from '@/config/site';
import Button from '../ui/Button.astro';
import Container from '../ui/Container.astro';
import Icon from '../ui/Icon.astro';
import ThemeToggle from '../ui/ThemeToggle.astro';
---

<header class="sticky top-0 z-40 border-b border-line bg-bg/90 backdrop-blur-md">
  <Container class="flex h-header items-center justify-between gap-4">
    <a href="/" class="flex min-h-11 items-center gap-2.5 text-ink" aria-label={`${site.brand}, torna alla home`}>
      <span class="grid size-9 place-items-center rounded-full bg-primary text-on-primary">
        <Icon name="leaf" size={18} />
      </span>
      <span class="font-display text-[1.3125rem] leading-none font-medium tracking-tight whitespace-nowrap">{site.brand}</span>
    </a>

    <nav aria-label="Principale" class="hidden lg:block">
      <ul class="flex items-center gap-1">
        {
          navigation.map((item) => (
            <li>
              <a
                href={item.href}
                class="inline-flex min-h-11 items-center rounded-full px-3.5 text-small font-medium text-muted hover:text-ink"
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="flex items-center gap-1">
      <ThemeToggle />
      <div class="ml-2 hidden lg:block">
        <Button href={cta.primary.href}>{cta.primary.label}</Button>
      </div>
      <button
        type="button"
        class="inline-flex size-11 items-center justify-center rounded-full text-ink transition-transform duration-(--duration-fast) ease-out active:scale-90 lg:hidden"
        aria-label="Apri il menu"
        aria-expanded="false"
        aria-controls="menu-mobile"
        data-menu-open
      >
        <Icon name="menu" size={24} />
      </button>
    </div>
  </Container>
</header>

<!-- <dialog> nativo: focus intrappolato, chiusura con Esc e ritorno del focus sono gestiti dal browser -->
<dialog id="menu-mobile" aria-label="Menu" class="mobile-menu">
  <div class="flex h-header items-center justify-between px-gutter">
    <span class="font-display text-[1.3125rem] leading-none font-medium tracking-tight whitespace-nowrap">{site.brand}</span>
    <button
      type="button"
      class="inline-flex size-11 items-center justify-center rounded-full text-ink transition-transform duration-(--duration-fast) ease-out active:scale-90"
      aria-label="Chiudi il menu"
      data-menu-close
    >
      <Icon name="close" size={24} />
    </button>
  </div>

  <nav aria-label="Menu principale" class="px-gutter pt-4">
    <ul class="divide-y divide-line border-y border-line">
      {
        navigation.map((item) => (
          <li>
            <a href={item.href} class="flex min-h-14 items-center justify-between font-display text-h3" data-menu-link>
              {item.label}
              <Icon name="arrow" class="text-muted" />
            </a>
          </li>
        ))
      }
    </ul>
  </nav>

  <div class="grid gap-3 px-gutter pt-8 pb-[calc(2rem+env(safe-area-inset-bottom))]">
    <Button href={cta.primary.href} size="lg" block data-menu-link>{cta.primary.label}</Button>
    <div class="grid grid-cols-2 gap-3">
      <Button href={phoneUrl} variant="secondary" size="lg" icon="phone" block>Chiama</Button>
      <Button href={whatsappUrl()} variant="secondary" size="lg" icon="whatsapp" block rel="noopener">WhatsApp</Button>
    </div>
    <p class="pt-2 text-center text-small text-muted">{cta.note}</p>
  </div>
</dialog>

<style is:global>
  .mobile-menu {
    position: fixed;
    inset: 0;
    width: 100%;
    max-width: none;
    height: 100dvh;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background-color: var(--bg);
    color: var(--ink);
    overflow-y: auto;
    overscroll-behavior: contain;
  }
  .mobile-menu::backdrop {
    background-color: var(--bg);
  }
  .mobile-menu[open] {
    animation: menu-in var(--duration-base) var(--ease-out);
  }
  @keyframes menu-in {
    from {
      opacity: 0;
      transform: translateY(-0.75rem);
    }
  }
</style>

<script>
  const dialog = document.querySelector<HTMLDialogElement>('#menu-mobile');
  const openButton = document.querySelector<HTMLButtonElement>('[data-menu-open]');

  if (dialog && openButton) {
    openButton.addEventListener('click', () => {
      dialog.showModal();
      openButton.setAttribute('aria-expanded', 'true');
    });

    dialog.querySelector('[data-menu-close]')?.addEventListener('click', () => dialog.close());

    // Un link interno chiude il menu prima di scorrere alla sezione.
    dialog.querySelectorAll('[data-menu-link]').forEach((link) => link.addEventListener('click', () => dialog.close()));

    // "close" scatta anche con Esc: lo stato del pulsante resta sempre allineato.
    dialog.addEventListener('close', () => openButton.setAttribute('aria-expanded', 'false'));

    // Passando a desktop con il menu aperto, lo si chiude.
    window.matchMedia('(min-width: 64rem)').addEventListener('change', (event) => {
      if (event.matches && dialog.open) dialog.close();
    });
  }
</script>
